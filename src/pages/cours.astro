---
import Base from '../layouts/Base.astro';
import PlanningDay from '../components/cours/PlanningDay.astro';
import DanceFamily from '../components/cours/DanceFamily.astro';
import CalendarRow from '../components/cours/CalendarRow.astro';
import CtaFinal from '../components/cours/CtaFinal.astro';
import { getCollection, getEntry } from 'astro:content';

const ordreJours = ['lundi', 'jeudi', 'vendredi'];
const horaires = (await getCollection('horaires')).sort(
  (a, b) => ordreJours.indexOf(a.id) - ordreJours.indexOf(b.id)
);
const jours = await Promise.all(
  horaires.map(async (jour) => ({ jour, lieu: await getEntry(jour.data.lieu) }))
);

const danses = (await getCollection('danses')).sort((a, b) => a.data.ordre - b.data.ordre);

const maintenant = new Date();
const evenements = (await getCollection('evenements')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);
---
<Base
  title="Nos cours — Cadence Danse Club"
  description="Horaires, danses enseignées et calendrier de Cadence Danse Club à Verchamps et Roimont."
  preloadImage="/images/solo-lg.webp"
>
  <section class="mx-auto grid max-w-7xl items-end gap-12 px-5 pb-20 pt-8 sm:px-8 md:grid-cols-12 md:items-center lg:pb-28 lg:pt-16">
    <div class="md:col-span-7">
      <p class="eyebrow text-bordeaux">Verchamps · Roimont</p>
      <h1 class="display display-xl mt-6">Nos <em class="text-bordeaux">cours.</em></h1>
      <p class="mt-8 max-w-md text-lg leading-relaxed text-brun/80">
        Trois soirs par semaine, du premier pas aux figures avancées. Tarifs : contactez-nous.
      </p>
      <nav class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-semibold" aria-label="Sur cette page">
        <a href="#planning" class="link-underline pb-0.5">Le planning</a>
        <a href="#danses" class="link-underline pb-0.5">Les danses</a>
        <a href="#calendrier" class="link-underline pb-0.5">Le calendrier</a>
      </nav>
    </div>
    <div class="md:col-span-5 lg:col-span-4 lg:col-start-9">
      <div class="arch mx-auto aspect-[3/4] w-3/4 max-w-sm bg-brun/10 md:w-full">
        <img
          src="/images/solo-lg.webp"
          srcset="/images/solo-sm.webp 800w, /images/solo-lg.webp 1600w"
          sizes="(min-width: 1024px) 30vw, 75vw"
          alt="Une danseuse tourne sur scène, bras en mouvement"
          width="1600"
          height="1067"
          fetchpriority="high"
          class="h-full w-full object-cover object-[40%_50%]"
        />
      </div>
    </div>
  </section>

  <section id="planning" class="scroll-mt-24 border-t border-brun/15">
    <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-28">
      <p class="eyebrow text-bordeaux">Le planning</p>
      <h2 class="display display-lg mt-5">Choisissez <em class="text-bordeaux">votre</em> soirée.</h2>
      <div class="mt-16 grid gap-16 md:grid-cols-2 md:gap-x-10 lg:grid-cols-3">
        {jours.map(({ jour, lieu }) => <PlanningDay jour={jour} lieu={lieu} />)}
      </div>
    </div>
  </section>

  <section id="danses" class="scroll-mt-24 bg-creme">
    <div class="mx-auto max-w-7xl px-5 pt-8 sm:px-8">
      <p class="eyebrow text-bordeaux">Nos danses</p>
      <h2 class="display display-lg mt-5">De la valse <em class="text-bordeaux">au jive.</em></h2>
      <div class="mt-12">
        {danses.map((danse, i) => <DanceFamily danse={danse} inverse={i % 2 === 1} />)}
      </div>
    </div>
  </section>

  <section id="calendrier" class="scroll-mt-24 border-t border-brun/15">
    <div class="mx-auto max-w-5xl px-5 py-24 sm:px-8 lg:py-28">
      <p class="eyebrow text-bordeaux">Calendrier</p>
      <h2 class="display display-lg mt-5">À <em class="text-bordeaux">noter.</em></h2>
      <ul class="mt-12 border-t border-brun/15">
        {evenements.map((e) => <CalendarRow evenement={e} passe={e.data.date.getTime() < maintenant.getTime()} />)}
      </ul>
    </div>
  </section>

  <CtaFinal />
</Base>
