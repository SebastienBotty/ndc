---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import LieuxMap from '../components/LieuxMap.astro';
---
<Base
  title="Contact — New Dance Club"
  description="Contactez le New Dance Club : téléphone, email, Facebook, adresses des salles de Hannut et Jandrain."
>
  <section class="mx-auto max-w-7xl px-5 pb-20 pt-8 sm:px-8 lg:pb-28 lg:pt-16">
    <p class="eyebrow text-bordeaux">Contact</p>
    <h1 class="display display-xl mt-6">On se <br /><em class="text-bordeaux">rencontre ?</em></h1>

    <div class="mt-16 grid gap-12 border-t border-brun/15 pt-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow text-brun/60">Par téléphone</p>
        <a href="tel:+32495326647" class="display tabular mt-4 block text-[clamp(2.6rem,7vw,5.5rem)] leading-none transition-colors hover:text-bordeaux">
          0495 32 66 47
        </a>
      </div>
      <div class="flex flex-col gap-8 lg:col-span-4 lg:col-start-9">
        <div>
          <p class="eyebrow text-brun/60">Par email</p>
          <a href="mailto:ndc1350@gmail.com" class="link-underline display mt-3 inline-block pb-1 text-3xl">ndc1350@gmail.com</a>
        </div>
        <div>
          <p class="eyebrow text-brun/60">Sur Facebook</p>
          <a href="https://www.facebook.com/profile.php?id=100057211669508" class="link-underline display mt-3 inline-block pb-1 text-3xl">
            <em>New Dance Club</em> ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-nuit text-creme">
    <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-28">
      <p class="eyebrow text-or">Où nous trouver</p>
      <h2 class="display display-lg mt-5">Deux <em class="text-or">salles.</em></h2>
      <div class="mt-14">
        <LieuxMap />
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:py-32">
    <div class="lg:col-span-4">
      <p class="eyebrow text-bordeaux">Écrire au club</p>
      <h2 class="display display-lg mt-5">Un <em class="text-bordeaux">mot ?</em></h2>
      <p class="mt-6 max-w-sm leading-relaxed text-brun/75">
        Une question sur les cours, les niveaux ou les inscriptions : le comité vous répond par email.
      </p>
    </div>
    <div class="lg:col-span-7 lg:col-start-6">
      <ContactForm />
    </div>
  </section>
</Base>
