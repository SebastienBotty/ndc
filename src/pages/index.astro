---
import Base from '../layouts/Base.astro';
import HeroHome from '../components/home/HeroHome.astro';
import Marquee from '../components/Marquee.astro';
import DanceIndex from '../components/home/DanceIndex.astro';
import WeekOutline from '../components/home/WeekOutline.astro';
import ClubLife from '../components/home/ClubLife.astro';
import NextEventBig from '../components/home/NextEventBig.astro';
import QuoteDuotone from '../components/home/QuoteDuotone.astro';
import SponsorBar from '../components/SponsorBar.astro';
import { getCollection } from 'astro:content';
import { getNextEvent } from '../lib/evenements';

const evenements = await getCollection('evenements');
const prochainEvenement = getNextEvent(evenements.map((e) => ({ id: e.id, ...e.data })));
---
<Base
  title="Cadence Danse Club — Cours de danse à Verchamps et Roimont"
  description="Cours de danse pour tous niveaux à Verchamps et Roimont : rock, salsa, bachata, danses de salon et danses latines."
  preloadImage="/images/tango-couple-lg.webp"
>
  <HeroHome />
  <Marquee
    items={['Rock', 'Salsa', 'Bachata', 'Tango', 'Valse', 'Cha-cha', 'Rumba', 'Line dance']}
    eyebrow="Ce qu'on y danse"
    label="Danses enseignées : rock, salsa, bachata, tango, valse, cha-cha, rumba, line dance"
  />
  <DanceIndex />
  <WeekOutline />
  <ClubLife />
  {prochainEvenement && <NextEventBig evenement={prochainEvenement} />}
  <QuoteDuotone />
  <SponsorBar />
</Base>
