---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  preloadImage?: string;
}

const { title, description, preloadImage } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'DanceSchool',
  name: 'Cadence Danse Club',
  url: Astro.site?.toString(),
  telephone: '+32470112233',
  email: 'contact@example.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rue des Tanneurs 4',
    postalCode: '1457',
    addressLocality: 'Roimont',
    addressCountry: 'BE',
  },
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta name="theme-color" content="#7A1F2B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script is:inline>
      if (
        !CSS.supports('animation-timeline: view()') &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body class="antialiased">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded focus:bg-bordeaux focus:px-4 focus:py-2 focus:text-creme">
      Aller au contenu
    </a>
    <p class="bg-nuit px-4 py-2 text-center text-xs font-semibold text-creme/90">
      Maquette de démonstration — projet fictif présenté à titre de portfolio.
    </p>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
