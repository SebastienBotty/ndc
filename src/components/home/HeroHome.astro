---
import StepDiagram from '../StepDiagram.astro';
---
<section class="relative mx-auto grid max-w-7xl gap-12 px-5 pb-20 pt-6 sm:px-8 md:grid-cols-12 md:items-center md:gap-8 md:pt-10 lg:pb-28 lg:pt-12">
  <div class="relative z-10 flex flex-col justify-center md:col-span-7">
    <p class="eyebrow text-bordeaux">Club de danse · Verchamps &amp; Roimont</p>
    <h1 class="display display-xl mt-6 text-brun">
      On danse <br /><em class="text-bordeaux">ensemble.</em>
    </h1>
    <p class="mt-8 max-w-md text-lg leading-relaxed text-brun/80">
      Rock, salsa, bachata, danses de salon et latines. Trois soirs par semaine, et les débutants sont les bienvenus.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href="/cours"
        class="group inline-flex items-center gap-3 rounded-full bg-bordeaux px-7 py-4 font-semibold text-creme transition hover:bg-bordeaux-sombre"
      >
        Voir les horaires
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href="/contact" class="link-underline pb-0.5 font-semibold text-brun">Poser une question</a>
    </div>
  </div>

  <div class="relative md:col-span-5">
    <div class="arch relative mx-auto aspect-[3/4] w-[82%] max-w-md bg-brun/10 md:w-full">
      <img
        src="/images/tango-couple-lg.webp"
        srcset="/images/tango-couple-sm.webp 600w, /images/tango-couple-lg.webp 1000w"
        sizes="(min-width: 768px) 40vw, 80vw"
        alt="Un couple danse le tango sur un parquet, photo en noir et blanc"
        width="1000"
        height="1500"
        fetchpriority="high"
        class="parallax h-full w-full object-cover object-[50%_60%]"
      />
    </div>

    <div class="absolute -bottom-6 left-0 aspect-square w-32 overflow-hidden rounded-full border-[6px] border-creme bg-brun/10 sm:w-40 md:-left-8 md:w-32 lg:-left-16 lg:w-44">
      <img
        src="/images/milonga-sm.webp"
        alt="Pieds de danseuses et de danseurs sur la piste"
        width="800"
        height="533"
        class="h-full w-full scale-150 object-cover object-[55%_85%]"
      />
    </div>

    <StepDiagram class="absolute -left-56 top-4 hidden w-40 xl:block" tone="bordeaux" />
  </div>
</section>
