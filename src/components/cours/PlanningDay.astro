---
import type { CollectionEntry } from 'astro:content';
import LevelBadge from '../LevelBadge.astro';

export interface Props {
  jour: CollectionEntry<'horaires'>;
  lieu: CollectionEntry<'lieux'> | undefined;
}
const { jour, lieu } = Astro.props;
const { jour: nomJour, label, creneaux } = jour.data;
---
<article class="reveal md:last:odd:col-span-2 md:last:odd:w-[calc(50%-1.25rem)] md:last:odd:justify-self-center lg:last:odd:col-span-1 lg:last:odd:w-auto lg:last:odd:justify-self-stretch">
  <h3 class="display outline-text text-[clamp(3.5rem,7vw,6rem)] leading-none">{nomJour}</h3>

  {lieu && (
    <div class="mt-4">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
        <p class="eyebrow text-bordeaux">{lieu.data.nom}</p>
        {label && (
          <span class="-rotate-6 rounded-md border-2 border-or px-2.5 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-bordeaux">
            {label}
          </span>
        )}
      </div>
      <p class="mt-1 text-sm text-brun/60">{lieu.data.adresse}</p>
    </div>
  )}

  <ul class="mt-6 border-t border-brun/15">
    {creneaux.map((c) => (
      <li class="grid grid-cols-[4.5rem_1fr] gap-x-4 gap-y-1 border-b border-brun/15 py-4">
        <span class="display tabular row-span-2 text-2xl leading-tight">{c.heure}</span>
        <span class="font-medium leading-snug">{c.cours}</span>
        <LevelBadge niveau={c.niveau} />
      </li>
    ))}
  </ul>
</article>
