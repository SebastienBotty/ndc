---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

export interface Props {
  danse: CollectionEntry<'danses'>;
  inverse?: boolean;
}
const { danse, inverse = false } = Astro.props;
const { Content } = await render(danse);
const { titre, slug, image, danses } = danse.data;
---
<article id={slug} class="scroll-mt-28 border-t border-brun/15 py-16 lg:py-24">
  <div class="grid items-center gap-10 md:grid-cols-12 md:gap-10 lg:gap-16">
    <div class={`reveal md:col-span-5 ${inverse ? 'md:order-2 md:col-start-8' : ''}`}>
      <div class="arch mx-auto aspect-[4/5] max-w-sm bg-brun/10 md:max-w-none">
        <img
          src={`/images/${image}-lg.webp`}
          srcset={`/images/${image}-sm.webp 800w, /images/${image}-lg.webp 1600w`}
          sizes="(min-width: 768px) 38vw, 90vw"
          alt=""
          width="1600"
          height="2000"
          loading="lazy"
          class="parallax h-full w-full object-cover"
        />
      </div>
    </div>

    <div class={`md:col-span-7 lg:col-span-6 ${inverse ? 'md:order-1 md:col-start-1' : 'lg:col-start-7'}`}>
      <h3 class="display display-lg">{titre}</h3>
      <div class="mt-6 max-w-xl text-lg leading-relaxed text-brun/80">
        <Content />
      </div>
      <dl class="mt-10 grid gap-x-10 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
        {danses.map((d) => (
          <div class="border-t border-or/70 py-5">
            <dt class="display text-2xl"><em>{d.nom}</em></dt>
            <dd class="mt-2 text-sm leading-relaxed text-brun/70">{d.description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</article>
