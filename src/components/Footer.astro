---
import { getCollection } from 'astro:content';

const lieux = await getCollection('lieux');
const annee = new Date().getFullYear();
---
<footer class="overflow-hidden bg-nuit text-creme">
  <div class="mx-auto max-w-7xl px-5 pt-20 sm:px-8">
    <div class="grid gap-10 text-sm sm:grid-cols-2 lg:grid-cols-4">
      {lieux.map((lieu) => (
        <div>
          <p class="eyebrow text-or">{lieu.data.role === 'cours' ? 'Cours' : 'Entraînement'}</p>
          <p class="mt-3 text-creme/80">{lieu.data.adresse}</p>
        </div>
      ))}
      <div>
        <p class="eyebrow text-or">Nous joindre</p>
        <p class="mt-3"><a href="tel:+32470112233" class="link-underline text-creme/80">0470 11 22 33</a></p>
        <p><a href="mailto:contact@example.com" class="link-underline text-creme/80">contact@example.com</a></p>
      </div>
      <div>
        <p class="eyebrow text-or">Suivre</p>
        <p class="mt-3">
          <a href="https://facebook.com" class="link-underline text-creme/80">Facebook</a>
        </p>
        <p><a href="/cours" class="link-underline text-creme/80">Horaires des cours</a></p>
      </div>
    </div>
  </div>

  <p
    class="display mt-16 select-none whitespace-nowrap px-3 text-center text-[clamp(2.6rem,12vw,13rem)] leading-[0.8] text-creme/95"
    aria-hidden="true"
  >
    Cadence <em class="text-or">Danse</em> Club
  </p>

  <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-2 border-t border-creme/10 px-5 py-6 text-xs text-creme/50 sm:px-8">
    <p>© {annee} Cadence Danse Club — maquette de démonstration</p>
    <p>Photos : Unsplash (provisoires)</p>
  </div>
</footer>
