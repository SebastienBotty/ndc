---
export interface Props {
  items: string[];
  eyebrow?: string;
  label?: string;
}
const { items, eyebrow, label } = Astro.props;
const serie = [...items, ...items];
---
<section class="border-y border-brun/15 py-14" aria-label={label ?? items.join(', ')}>
  {eyebrow && (
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow text-bordeaux">{eyebrow}</p>
    </div>
  )}
  <div class="marquee mt-8">
    <div class="marquee-track" aria-hidden="true">
      {serie.map((item) => (
        <span class="display flex items-center whitespace-nowrap px-8 text-[clamp(2rem,5vw,4rem)] leading-none text-bordeaux">
          <em>{item}</em>
          <span class="ml-12 text-[0.5em] text-or">✦</span>
        </span>
      ))}
    </div>
  </div>
</section>
