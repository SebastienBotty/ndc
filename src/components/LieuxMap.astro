---
import { getCollection } from 'astro:content';
import { googleMapsUrl } from '../lib/carte';

const ordreRoles = ['cours', 'entrainement'];
const lieux = (await getCollection('lieux')).sort(
  (a, b) => ordreRoles.indexOf(a.data.role) - ordreRoles.indexOf(b.data.role)
);
const libelleRole = { cours: 'Cours', entrainement: 'Entraînement' } as const;
const points = lieux.map((lieu) => ({
  id: lieu.id,
  nom: lieu.data.nom,
  role: libelleRole[lieu.data.role],
  accent: lieu.data.role === 'cours' ? 'bordeaux' : 'or',
  lat: lieu.data.lat,
  lon: lieu.data.lon,
}));
---
<div class="grid gap-10 lg:grid-cols-12 lg:gap-12" data-lieux-map>
  <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-4 lg:grid-cols-1 lg:content-center">
    {lieux.map((lieu) => (
      <li class="reveal">
        <button
          type="button"
          data-lieu={lieu.id}
          class="group w-full rounded-2xl border border-creme/15 p-6 text-left transition hover:border-or/60 aria-pressed:border-or aria-pressed:bg-creme/5"
          aria-pressed="false"
        >
          <span class="flex items-center gap-3">
            <span class={`h-3 w-3 rounded-full ring-4 ${lieu.data.role === 'cours' ? 'bg-bordeaux ring-bordeaux/30' : 'bg-or ring-or/25'}`} aria-hidden="true"></span>
            <span class="eyebrow text-or">{libelleRole[lieu.data.role]}</span>
          </span>
          <span class="display display-md mt-4 block">{lieu.data.nom}</span>
          <span class="mt-2 block text-creme/75">{lieu.data.adresse}</span>
          <span class="mt-4 block text-sm font-semibold text-creme/60 transition group-hover:text-or">Centrer la carte</span>
        </button>
        <a
          href={googleMapsUrl(lieu.data.adresse)}
          class="group mt-3 inline-flex items-center gap-2 rounded-full border border-creme/25 px-5 py-2.5 text-sm font-semibold text-creme transition hover:border-or hover:bg-or hover:text-nuit"
          target="_blank"
          rel="noopener"
        >
          Ouvrir dans Google Maps
          <span aria-hidden="true" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
          <span class="sr-only">(nouvel onglet)</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="relative lg:col-span-8">
    <div
      id="carte-lieux"
      class="isolate z-0 h-[26rem] w-full overflow-hidden rounded-t-[7rem] rounded-b-[2rem] sm:rounded-t-[12rem] bg-creme/5 sm:h-[32rem] lg:h-[36rem]"
      data-points={JSON.stringify(points)}
      role="region"
      aria-label="Carte des salles du club à Hannut et Jandrain"
    ></div>
  </div>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Point = { id: string; nom: string; role: string; accent: 'bordeaux' | 'or'; lat: number; lon: number };

  const conteneur = document.getElementById('carte-lieux');
  const racine = document.querySelector<HTMLElement>('[data-lieux-map]');

  if (conteneur && racine) {
    const points: Point[] = JSON.parse(conteneur.dataset.points ?? '[]');
    const carte = L.map(conteneur, { scrollWheelZoom: false, zoomControl: false, attributionControl: true });
    L.control.zoom({ position: 'bottomleft' }).addTo(carte);
    const lonMin = Math.min(...points.map((p) => p.lon));

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(carte);

    const marqueurs = new Map<string, L.Marker>();
    for (const point of points) {
      const icone = L.divIcon({
        className: 'lieu-marqueur',
        html: `<span class="lieu-pin lieu-pin--${point.accent}"></span><span class="lieu-etiquette lieu-etiquette--${point.lon === lonMin ? 'haut' : 'bas'}"><strong>${point.role}</strong> · ${point.nom}</span>`,
        iconSize: [0, 0],
        iconAnchor: [0, 0],
      });
      const marqueur = L.marker([point.lat, point.lon], { icon: icone, title: `${point.role} — ${point.nom}`, keyboard: false }).addTo(carte);
      marqueurs.set(point.id, marqueur);
    }

    const bornes = L.latLngBounds(points.map((p) => [p.lat, p.lon] as [number, number]));
    carte.fitBounds(bornes, { padding: [90, 80], maxZoom: 15 });

    const boutons = racine.querySelectorAll<HTMLButtonElement>('[data-lieu]');
    boutons.forEach((bouton) => {
      bouton.addEventListener('click', () => {
        const point = points.find((p) => p.id === bouton.dataset.lieu);
        if (!point) return;
        const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
        carte.flyTo([point.lat, point.lon], 16, { animate: !reduit, duration: 1.2 });
        boutons.forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
        marqueurs.forEach((m, id) => m.getElement()?.classList.toggle('is-active', id === point.id));
        if (window.innerWidth < 1024) conteneur.scrollIntoView({ behavior: reduit ? 'auto' : 'smooth', block: 'center' });
      });
    });
  }
</script>

<style is:global>
  #carte-lieux .leaflet-tile-pane {
    filter: grayscale(0.55) sepia(0.2) contrast(1.02);
  }

  #carte-lieux .leaflet-control-attribution {
    background: rgb(251 245 236 / 0.85);
    font-size: 10px;
  }

  .lieu-marqueur {
    position: relative;
  }

  .lieu-pin {
    position: absolute;
    left: -11px;
    top: -11px;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 3px solid #fbf5ec;
    box-shadow: 0 4px 14px rgb(28 15 20 / 0.45);
  }

  .lieu-pin::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 999px;
    border: 2px solid currentColor;
    opacity: 0;
    animation: lieu-pulse 2.4s ease-out infinite;
  }

  .lieu-pin--bordeaux {
    background: #7a1f2b;
    color: #7a1f2b;
  }

  .lieu-pin--or {
    background: #d9a441;
    color: #b8862a;
  }

  .lieu-etiquette {
    position: absolute;
    left: 0;
    translate: -50% 0;
    white-space: nowrap;
    border-radius: 999px;
    background: #1c0f14;
    color: #fbf5ec;
    padding: 5px 12px;
    font: 500 12px/1.2 'Figtree Variable', system-ui, sans-serif;
    box-shadow: 0 6px 18px rgb(28 15 20 / 0.3);
    transition: scale 0.25s ease;
  }

  .lieu-etiquette--haut {
    top: -48px;
  }

  .lieu-etiquette--bas {
    top: 20px;
  }

  .lieu-etiquette strong {
    font-weight: 700;
    color: #d9a441;
  }

  .lieu-marqueur.is-active .lieu-etiquette {
    scale: 1.08;
  }

  @keyframes lieu-pulse {
    0% {
      opacity: 0.7;
      transform: scale(0.6);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
</style>
