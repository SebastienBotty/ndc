---
import { labelNiveau, classeNiveau } from '../lib/niveaux';
import type { Niveau } from '../lib/niveaux';

export interface Props {
  niveau: Niveau;
}
const { niveau } = Astro.props;
---
<span class="inline-flex items-center gap-2 whitespace-nowrap text-xs font-semibold uppercase tracking-wider text-brun/70">
  <span class={`h-2 w-2 rounded-full ${classeNiveau(niveau)}`} aria-hidden="true"></span>
  {labelNiveau(niveau)}
</span>
