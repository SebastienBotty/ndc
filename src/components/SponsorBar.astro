---
import { getCollection } from 'astro:content';

const sponsors = await getCollection('sponsors');
const serie = [...sponsors, ...sponsors, ...sponsors, ...sponsors];
---
<section class="border-y border-brun/15 py-14" aria-label="Nos partenaires">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="eyebrow text-brun/70">Ils soutiennent le club</p>
  </div>
  <div class="marquee mt-8">
    <ul class="marquee-track">
      {serie.map((s, i) => (
        <li class="display flex items-center whitespace-nowrap px-8 text-3xl text-brun/40" aria-hidden={i >= sponsors.length ? 'true' : undefined}>
          <em>{s.data.nom}</em>
          <span class="ml-16 text-base text-or" aria-hidden="true">✦</span>
        </li>
      ))}
    </ul>
  </div>
</section>
